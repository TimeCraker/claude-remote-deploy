# 飞书应用凭证（在 https://open.feishu.cn 创建应用后获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# MiMo API 配置
MIMO_API_KEY=tp-your_mimo_api_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# Claude Code 配置
CLAUDE_BIN=/usr/local/bin/claude
CLAUDE_WORK_DIR=/home/ubuntu/projects

# 数据库路径
DB_PATH=/opt/claude-remote-bot/data/bot.db
